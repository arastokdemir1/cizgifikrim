{% set c = modern.copy[entry.lang] %}{% set links = modern.links[entry.lang] %}{% set en = entry.lang == 'en' %}
{% from "modern/macros.njk" import arrow, brand, chevron %}
<!doctype html>
<html lang="{{ entry.lang }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark">
<title>{{ entry.title }}</title><meta name="description" content="{{ entry.metaDescription }}">
<link rel="canonical" href="{{ site.url }}{{ entry.url }}">
{% if entry.alternate and not entry.noindex %}<link rel="alternate" hreflang="{{ 'tr' if en else 'en' }}" href="{{ site.url }}{{ entry.alternate }}"><link rel="alternate" hreflang="{{ entry.lang }}" href="{{ site.url }}{{ entry.url }}"><link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ entry.url if en else entry.alternate }}">{% endif %}
{% if entry.noindex or env.onizleme %}<meta name="robots" content="noindex,follow">{% endif %}
<meta property="og:title" content="{{ entry.title }}"><meta property="og:description" content="{{ entry.metaDescription }}"><meta property="og:url" content="{{ site.url }}{{ entry.url }}"><meta property="og:type" content="{{ 'article' if entry.view == 'article' else 'website' }}"><meta property="og:site_name" content="CizgiFikrim"><meta property="og:locale" content="{{ 'en_US' if en else 'tr_TR' }}"><meta property="og:image" content="{{ site.url }}{{ entry.og }}"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="{{ entry.title }}">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ entry.title }}"><meta name="twitter:description" content="{{ entry.metaDescription }}"><meta name="twitter:image" content="{{ site.url }}{{ entry.og }}">
<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme:light)"><meta name="theme-color" content="#101010" media="(prefers-color-scheme:dark)">
<link rel="icon" href="/assets/v1/img/brand/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/assets/v1/img/brand/apple-touch-icon.png">
<link rel="preload" href="/assets/v1/fonts/nunito-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/v1/css/renewal-fonts.css"><link rel="stylesheet" href="/assets/v1/css/modern.css?v=20261114-project-stages">
<script src="/assets/v1/js/modern.js?v=20261114-project-stages" defer></script>
{% if entry.view == 'contact' %}<script src="/assets/v1/js/lead-form.js" defer></script><script src="/assets/v1/js/cal-lazy.js" defer></script>{% endif %}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://cizgifikrim.net/#org","name":"CizgiFikrim","url":"https://cizgifikrim.net","logo":"https://cizgifikrim.net/assets/v1/img/brand/icon-512.png"},{"@type":"WebPage","name":{{ entry.title | jsonld | safe }},"url":"{{ site.url }}{{ entry.url }}","inLanguage":"{{ entry.lang }}","isPartOf":{"@id":"https://cizgifikrim.net/#org"}}]}</script>
{% if entry.view == 'home' %}<link rel="stylesheet" href="/assets/v1/css/home.css?v=20261114-b2b">{% else %}<link rel="stylesheet" href="/assets/v1/css/pages.css?v=20261114-pages">{% endif %}{% if entry.view == 'products' %}<link rel="stylesheet" href="/assets/v1/css/catalog.css?v=20261115-nosearch"><script src="/assets/v1/js/catalog.js?v=20261115-nosearch" defer></script>{% endif %}<link rel="stylesheet" href="/assets/v1/css/renewal.css?v=20261117-restored"></head>
<body data-page="{{ entry.key }}">
<a class="skip" href="#main">{{ c.skip }}</a>
<header class="header"><div class="shell header-inner">
<a class="brand" href="{{ links.home }}" aria-label="CizgiFikrim · {{ c.home }}">{{ brand() }}</a>
<nav class="desktop-nav" aria-label="{{ c.mainNav }}">
<details class="nav-group"{% if entry.section == 'products' or entry.key == 'products' %} data-active{% endif %}><summary>{{ c.nav[0] }} {{ chevron() }}</summary><div class="dropdown product-dropdown"><div class="dropdown-title"><span>{{ c.productList }}</span><a href="{{ links.products }}">{{ c.allProducts }} {{ arrow() }}</a></div><div class="dropdown-products">{% for p in modern.products %}<a href="{{ links.products }}{{ p.slug }}/"><span class="dropdown-product-name">{{ p.name }}</span><span>{{ p.short[entry.lang] }}</span>{{ arrow() }}</a>{% endfor %}</div></div></details>
<details class="nav-group"{% if entry.section == 'solutions' or entry.key == 'solutions' %} data-active{% endif %}><summary>{{ c.nav[1] }} {{ chevron() }}</summary><div class="dropdown solution-dropdown"><div class="dropdown-title"><span>{{ c.serviceList }}</span><a href="{{ links.solutions }}">{{ c.allSolutions }} {{ arrow() }}</a></div>{% for s in modern.services %}<a class="dropdown-service" href="{{ links.solutions }}{{ s.route[entry.lang] }}/"><span>{{ s.name[entry.lang] }}<small>{{ s.short[entry.lang] }}</small></span>{{ arrow() }}</a>{% endfor %}</div></details>
<a href="{{ links.about }}"{% if entry.key == 'about' %} aria-current="page"{% endif %}>{{ c.nav[2] }}</a><a href="{{ links.updates }}"{% if entry.key == 'updates' or entry.section == 'updates' %} aria-current="page"{% endif %}>{{ c.nav[3] }}</a>
</nav>
<div class="header-actions"><a class="language" href="{{ entry.alternate }}" data-language="{{ 'tr' if en else 'en' }}" hreflang="{{ 'tr' if en else 'en' }}" lang="{{ 'tr' if en else 'en' }}" aria-label="{{ 'Türkçe' if en else 'Switch to English' }}"><span{% if not en %} class="selected"{% endif %}>TR</span><span class="language-divider">/</span><span{% if en %} class="selected"{% endif %}>EN</span></a><a class="button compact contact-button" href="{{ links.contact }}">{{ c.contact }} {{ arrow() }}</a><button class="menu-toggle" type="button" data-menu-open aria-label="{{ c.menu }}" aria-controls="mobile-menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg></button></div>
</div></header>
<dialog class="mobile-menu" id="mobile-menu" aria-label="{{ c.mainNav }}"><div class="mobile-menu-top"><a class="brand" href="{{ links.home }}" aria-label="CizgiFikrim · {{ c.home }}">{{ brand() }}</a><button class="menu-toggle" type="button" data-menu-close aria-label="{{ c.close }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><nav aria-label="{{ c.mainNav }}"><details><summary>{{ c.nav[0] }} {{ chevron() }}</summary><div><a href="{{ links.products }}">{{ c.allProducts }} {{ arrow() }}</a>{% for p in modern.products %}<a href="{{ links.products }}{{ p.slug }}/">{{ p.name }} {{ arrow() }}</a>{% endfor %}</div></details><details><summary>{{ c.nav[1] }} {{ chevron() }}</summary><div><a href="{{ links.solutions }}">{{ c.allSolutions }} {{ arrow() }}</a>{% for s in modern.services %}<a href="{{ links.solutions }}{{ s.route[entry.lang] }}/">{{ s.name[entry.lang] }} {{ arrow() }}</a>{% endfor %}</div></details><a href="{{ links.about }}">{{ c.nav[2] }} {{ arrow() }}</a><a href="{{ links.updates }}">{{ c.nav[3] }} {{ arrow() }}</a></nav><a class="button mobile-contact" href="{{ links.contact }}">{{ c.contact }} {{ arrow() }}</a></dialog>
<noscript><nav class="shell no-js-nav" aria-label="{{ c.mainNav }}"><a href="{{ links.products }}">{{ c.nav[0] }}</a><a href="{{ links.solutions }}">{{ c.nav[1] }}</a><a href="{{ links.about }}">{{ c.nav[2] }}</a><a href="{{ links.contact }}">{{ c.contact }}</a></nav></noscript>
<main id="main" tabindex="-1">{{ content | safe }}</main>
<footer class="footer shell"><div class="footer-top"><div><a class="brand" href="{{ links.home }}" aria-label="CizgiFikrim · {{ c.home }}">{{ brand() }}</a><p>{{ c.footerText }}</p></div><nav aria-label="{{ c.footerNav }}"><div><h2>{{ c.nav[0] }}</h2>{% for p in modern.products %}<a href="{{ links.products }}{{ p.slug }}/">{{ p.name }}</a>{% endfor %}<a href="{{ links.products }}#other">{{ c.otherHeading }}</a></div><div><h2>{{ c.nav[1] }}</h2>{% for s in modern.services %}<a href="{{ links.solutions }}{{ s.route[entry.lang] }}/">{{ s.name[entry.lang] }}</a>{% endfor %}</div><div><h2>CizgiFikrim</h2><a href="{{ links.about }}">{{ c.nav[2] }}</a><a href="{{ links.updates }}">{{ c.nav[3] }}</a><a href="{{ links.contact }}">{{ c.contact }}</a></div></nav></div><div class="footer-bottom"><span>© 2026 CizgiFikrim</span><span>{{ c.time }}</span><div><a href="{{ links.privacy }}">{{ c.privacy }}</a><a href="{{ links.terms }}">{{ c.terms }}</a></div></div></footer>
<script src="/assets/v1/js/analytics.js" defer></script>
</body></html>
