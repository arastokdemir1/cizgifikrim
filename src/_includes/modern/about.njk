<section class="page-hero shell"><h1>{{ c.aboutTitle | replace('\n','<br>') | safe }}</h1><p>{{ c.aboutIntro }}</p></section>
<section class="company-purpose shell"><h2>{{ 'Fikir kadar, kullanımını da önemsiyoruz.' if not en else 'The experience matters as much as the idea.' }}</h2><p>{{ c.aboutBody }}</p><div class="company-paths"><div><h3>{{ c.ownProducts }}</h3><p>{{ c.storyOwnText }}</p><a class="text-link" href="{{ links.products }}">{{ 'Projelerimizi keşfedin' if not en else 'Explore our projects' }} {{ arrow() }}</a></div><div><h3>{{ 'İşletmeler için yazılım.' if not en else 'Software for businesses.' }}</h3><p>{{ c.storyBusinessText }}</p><a class="text-link" href="{{ links.solutions }}">{{ c.allSolutions }} {{ arrow() }}</a></div></div></section>
<section class="principles shell" aria-label="{{ 'Çalışma ilkelerimiz' if not en else 'Our principles' }}">{% for title,body in c.principles %}<article><h2>{{ title }}</h2><p>{{ body }}</p></article>{% endfor %}</section>
<section class="founder shell"><div><h2>Aras Tokdemir</h2><span class="product-type">{{ c.founder }}</span></div><div><p>{{ c.bio }}</p><a class="text-link" href="mailto:cizgifikrimnet@gmail.com">cizgifikrimnet@gmail.com {{ arrow(true) }}</a></div></section>{{ cta(c,links) }}
