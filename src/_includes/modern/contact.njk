<section class="page-hero shell align-left contact-hero"><h1>{{ c.contactTitle | replace('\n','<br>') | safe }}</h1><p>{{ c.contactIntro }}</p><a class="text-link" href="mailto:cizgifikrimnet@gmail.com">cizgifikrimnet@gmail.com {{ arrow(true) }}</a></section><section class="contact-grid shell"><section class="contact-form" data-lead data-lead-onek="lead" data-thanks="{{ links.thanks }}" aria-labelledby="form-heading"><h2 id="form-heading">{{ c.formTitle }}</h2><p class="form-intro">{{ 'İhtiyacınız, hedefiniz ve varsa mevcut durum hakkında birkaç cümle yeterli.' if not en else 'A few sentences about your needs, goals and current situation are enough.' }}</p><p class="gr-mock" data-lead-mock hidden>{{ c.preview }}</p><noscript><p class="gr-mock">{{ "The form is unavailable. Please email us instead." if en else "Form şu anda kullanılamıyor. Bize e-posta gönderebilirsin." }}</p></noscript><form method="post" data-lead-form novalidate><div class="form-two"><div class="gr-alan"><label for="lead-name">{{ c.name }}</label><input id="lead-name" name="name" autocomplete="name" maxlength="120" required><p id="err-lead-name" data-err="name" class="gr-hata" hidden></p></div><div class="gr-alan"><label for="lead-email">{{ c.email }}</label><input id="lead-email" name="email" type="email" autocomplete="email" maxlength="254" required><p id="err-lead-email" data-err="email" class="gr-hata" hidden></p></div></div><div class="gr-alan"><label for="lead-konu">{{ c.topic }}</label><select id="lead-konu" name="konu"><option value="diger">{{ c.other }}</option>{% for s in modern.services %}<option value="{{ s.form }}">{{ s.name[entry.lang] }}</option>{% endfor %}</select></div><div class="gr-alan"><label for="lead-message">{{ c.message }}</label><textarea id="lead-message" name="message" rows="5" maxlength="2000" required></textarea><p id="err-lead-message" data-err="message" class="gr-hata" hidden></p></div><div class="gr-bal" aria-hidden="true"><label for="lead-website">Website</label><input id="lead-website" name="website" tabindex="-1" autocomplete="off"></div><div class="gr-alan"><label class="consent"><input id="lead-consent" name="consent" type="checkbox" required><span><a href="{{ links.privacy }}#iletisim-formu" target="_blank" rel="noopener noreferrer">{{ c.privacy }}</a> · {{ c.consent }}</span></label><p id="err-lead-consent" data-err="consent" class="gr-hata" hidden></p></div><div class="gr-ozet" data-lead-summary tabindex="-1" role="alert" hidden></div><div class="form-submit"><button type="submit" class="button" data-lead-submit disabled>{{ c.send }} {{ arrow() }}</button><span data-lead-status role="status" aria-live="polite"></span></div></form></section><aside class="calendar-panel"><section data-cal aria-labelledby="calendar-heading"><h2 id="calendar-heading">{{ c.calendarTitle }}</h2><div data-cal-sahne class="calendar-stage" aria-live="polite"><div data-cal-iskelet><div class="calendar-symbol" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="10" y="15" width="44" height="40" rx="8"/><path d="M20 9v12M44 9v12M10 28h44M21 38h5m12 0h5M21 46h5"/></svg></div><p data-cal-durum>{{ c.calendarIntro }}</p><button type="button" class="button secondary" data-cal-ac>{{ c.calendarButton }} {{ arrow(true) }}</button></div></div><a class="text-link" data-cal-yedek href="https://cal.com/cizgifikrim" target="_blank" rel="noopener noreferrer">{{ c.calendarLink }} {{ arrow(true) }}</a></section></aside></section>
