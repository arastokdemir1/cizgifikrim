{% set u=entry.update %}<article class="article shell"><a class="breadcrumb" href="{{ links.updates }}">{{ c.nav[3] }} / CarLog</a><div class="article-meta"><span>{{ u.label[entry.lang] }}</span><time datetime="{{ u.date }}">{{ '2 Eylül 2026' if not en else 'September 2, 2026' }}</time></div><h1>{{ u.title[entry.lang] }}</h1><p class="lead">{{ u.summary[entry.lang] }}</p><div class="article-body">{% for p in u.paragraphs %}<p>{{ p[entry.lang] }}</p>{% endfor %}<p class="caption">{{ c.source }}: <a href="{{ u.source }}" target="_blank" rel="noopener noreferrer">{{ u.sourceLabel[entry.lang] }} {{ arrow(true) }}</a></p><a class="button" href="{{ links.products }}carlog/">CarLog {{ arrow() }}</a></div></article>{{ cta(c,links) }}
