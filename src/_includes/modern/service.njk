{% set s = entry.service %}
<section class="page-hero shell align-left"><a class="breadcrumb" href="{{ links.solutions }}">{{ c.nav[1] }} / {{ s.name[entry.lang] }}</a><h1>{{ s.title[entry.lang] }}</h1><p>{{ s.description[entry.lang] }}</p><a class="button" href="{{ links.contact }}?konu={{ s.form }}">{{ c.quote }} {{ arrow() }}</a></section>
<section class="deliverables shell"><div class="page-section-heading"><h2>{{ c.deliverables }}</h2><p>{{ 'Kapsamı ihtiyacınıza göre birlikte belirleriz.' if not en else 'We agree the scope around your needs.' }}</p></div><ul>{% for item in s.deliverables %}<li>{{ item[entry.lang] }}</li>{% endfor %}</ul></section>
<section class="related-product shell"><div class="page-section-heading"><h2>{{ 'Kendi ürünlerimizden.' if not en else 'From our own products.' }}</h2><p>{{ 'Bu alandaki ürün çalışmalarımızı keşfedin.' if not en else 'Explore our product work in this area.' }}</p></div>{% for p in modern.products %}{% if p.slug == s.example %}<article class="related-project-text"><div><h3>{{ p.name }}</h3><p>{{ p.description[entry.lang] }}</p></div><a class="button secondary" href="{{ links.products }}{{ p.slug }}/">{{ c.explore }} {{ arrow(true) }}</a></article>{% endif %}{% endfor %}</section>
{% include 'modern/page-process.njk' %}{{ cta(c,links) }}
