{% set p = entry.product %}
<section class="product-hero shell"><a class="breadcrumb" href="{{ links.products }}">{{ c.nav[0] }} / {{ p.name }}</a><div class="product-hero-grid"><div><span class="product-wordmark wordmark-{{ p.slug }}">{{ p.name }}</span><h1>{{ p.title[entry.lang] }}</h1><p class="lead">{{ p.description[entry.lang] }}</p><a class="button" href="{{ p.external }}" target="_blank" rel="noopener noreferrer">{{ p.action[entry.lang] }} {{ arrow(true) }}</a><p class="product-type">{{ p.status[entry.lang] }}</p></div></div></section>
<section class="product-story shell"><div><h2>{{ c.madeFor }}</h2><p>{{ p.audience[entry.lang] }}</p></div><div><h2>{{ c.why }}</h2><p>{{ p.problem[entry.lang] }}</p></div></section>
<section class="product-details shell"><div class="page-section-heading"><h2>{{ c.details }}</h2></div><div class="feature-points">{% for feature in p.features %}<p>{{ feature[entry.lang] }}</p>{% endfor %}</div>
</section>
<section class="start-section shell"><h2>{{ c.start }}</h2><ol>{% for step in p.steps %}<li>{{ step[entry.lang] }}</li>{% endfor %}</ol><a class="button" href="{{ p.external }}" target="_blank" rel="noopener noreferrer">{{ p.action[entry.lang] }} {{ arrow(true) }}</a>{% if p.slug == 'carlog' %}<a class="text-link" href="/demo/carlog/" target="_blank" rel="noopener noreferrer">{{ 'Örnek verilerle web demosu' if not en else 'Web demo with sample data' }} {{ arrow(true) }}</a>{% endif %}</section>{{ cta(c,links) }}
