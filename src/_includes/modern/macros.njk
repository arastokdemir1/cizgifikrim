{% macro productVisual(p,lang,c,large=false) %}
<div class="product-art art-{{ p.slug }}{% if large %} art-large{% endif %}">
{% if p.slug == 'vesira' %}<div class="room-compare" data-compare><img src="/assets/v1/img/projeler/vesira/salon-yenileme.webp" width="1280" height="853" alt="{{ p.alt[lang] }}" decoding="async"{% if large %} fetchpriority="high"{% endif %}><div class="room-before"><img src="/assets/v1/img/projeler/vesira/salon-once.webp" width="1280" height="853" alt="{{ c.before }}" decoding="async"></div><div class="compare-line" aria-hidden="true"><span><svg viewBox="0 0 24 24"><path d="m9 8-4 4 4 4m6-8 4 4-4 4"/></svg></span></div><span class="image-label label-left">{{ c.before }}</span><span class="image-label label-right">{{ c.after }}</span><input type="range" min="0" max="100" value="50" aria-label="{{ c.compare }}"></div>
{% elif p.slug == 'polishreel' %}<div class="jewelry-set"><img class="jewelry-main" src="/assets/v1/img/projeler/polishreel/ornek-studio.jpg" width="720" height="900" alt="{{ p.alt[lang] }}" decoding="async"><img class="jewelry-secondary" src="/assets/v1/img/projeler/polishreel/ornek-lifestyle.jpg" width="720" height="900" alt="{{ 'Aynı bileklik, yaşam sahnesi' if lang == 'tr' else 'The same bracelet, in a lifestyle scene' }}" decoding="async"></div>
{% else %}<div class="app-set"><img src="/assets/v1/img/projeler/carlog/1-canli.webp" width="1320" height="2868" alt="{{ 'CarLog canlı sürüş ekranı' if lang == 'tr' else 'CarLog live trip screen' }}" decoding="async"><img src="/assets/v1/img/projeler/carlog/2-hesapla.webp" width="1320" height="2868" alt="{{ p.alt[lang] }}" decoding="async"></div>{% endif %}
{% if p.slug != 'carlog' %}<span class="example-label">{{ c.example }}</span>{% endif %}</div>
{% endmacro %}
{% macro productCard(p,lang,c,links) %}<article class="product-card"><div class="product-card-body"><div class="product-name-line"><h2><a href="{{ links.products }}{{ p.slug }}/">{{ p.name }}</a></h2><a class="circle-link" href="{{ links.products }}{{ p.slug }}/" aria-label="{{ p.name }} · {{ c.explore }}">{{ arrow(true) }}</a></div><p>{{ p.short[lang] }}</p><span class="product-type">{{ p.category[lang] }}</span></div></article>{% endmacro %}
{% macro serviceRows(services,lang,links) %}<div class="service-rows">{% for s in services %}<a class="service-row" href="{{ links.solutions }}{{ s.route[lang] }}/"><h3>{{ s.name[lang] }}</h3><p>{{ s.short[lang] }}</p><span class="circle-link">{{ arrow(true) }}</span></a>{% endfor %}</div>{% endmacro %}
{% macro updateList(updates,lang,c,links) %}<div class="update-list">{% for u in updates %}<article class="update-row"><div><span class="status-label">CarLog · {{ u.label[lang] }}</span><time datetime="{{ u.date }}">{{ '2 Eylül 2026' if lang == 'tr' else 'September 2, 2026' }}</time></div><a href="{{ links.updates }}{{ u.slug }}/"><h3>{{ u.title[lang] }}</h3><p>{{ u.summary[lang] }}</p></a><a class="circle-link" href="{{ links.updates }}{{ u.slug }}/" aria-label="{{ u.title[lang] }}">{{ arrow() }}</a></article>{% endfor %}</div>{% endmacro %}
{% macro cta(c,links) %}<section class="cta shell"><div><h2>{{ c.cta }}</h2><p>{{ c.ctaText }}</p></div><a class="button" href="{{ links.contact }}">{{ c.talk }} {{ arrow() }}</a></section>{% endmacro %}

{% macro studioProduct(p,lang,c,links) %}
<article class="studio-product studio-product-{{ p.slug }}">
  <div class="studio-product-copy"><h3>{{ p.name }}</h3><p class="studio-product-promise">{{ p.title[lang] }}</p><span class="studio-product-status">{{ p.status[lang] }}</span><a class="button" href="{{ links.products }}{{ p.slug }}/" aria-label="{{ p.name }} · {{ c.explore }}">{{ c.explore }} {{ arrow(true) }}</a></div>
</article>
{% endmacro %}
