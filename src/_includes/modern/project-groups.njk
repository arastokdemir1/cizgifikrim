<div class="project-groups">{% for group in catalog.groups %}<details class="project-group" id="projects-{{ group.id }}"{% if entry.view == 'products' and loop.first %} open{% endif %}><summary><span>{{ group.title[entry.lang] }} <small>{{ group.projects.length }}</small></span>{{ chevron() }}</summary><div class="project-grid">{% for project in group.projects %}{% set projectPrefix = 'catalog-' %}{% include 'modern/project-card.njk' %}{% endfor %}</div></details>{% endfor %}</div>
