<div class="b2b-home">
<section class="studio-hero shell" aria-labelledby="showcase-heading">
  <h1 id="showcase-heading">{{ c.studioHeroStart }} <em>{{ c.studioHeroAccent }}</em><br> {{ c.studioHeroEnd }}</h1>
  <p>{{ homepage.intro[entry.lang] }}</p>
  <div class="studio-hero-actions"><a class="button" href="{{ links.contact }}">{{ homepage.contact[entry.lang] }} {{ arrow() }}</a><a class="button secondary" href="#our-products">{{ c.discover }} {{ arrow(true) }}</a></div>
  <nav class="home-product-shortcuts" aria-label="{{ c.productList }}">{% for p in modern.products %}<a href="#home-panel-{{ p.slug }}"><span>{{ p.name }}</span><small>{{ p.category[entry.lang] }}</small>{{ arrow(true) }}</a>{% endfor %}</nav>
</section>
<section class="home-business shell" aria-labelledby="business-heading">
  <div class="home-business-intro"><h2 id="business-heading">{{ homepage.businessTitle[entry.lang] }}</h2><p>{{ homepage.businessIntro[entry.lang] }}</p><a class="text-link" href="{{ links.solutions }}">{{ c.allSolutions }} {{ arrow() }}</a></div>
  <div class="home-business-options">{% for s in modern.services %}<a href="{{ links.solutions }}{{ s.route[entry.lang] }}/"><div><h3>{{ s.name[entry.lang] }}</h3><p>{{ homepage.serviceOutcomes[loop.index0][entry.lang] }}</p></div>{{ arrow(true) }}</a>{% endfor %}</div>
</section>
<section class="home-projects shell" id="our-products" aria-labelledby="products-heading">
  <div class="home-products-heading"><div><h2 id="products-heading">{{ 'Öne çıkan projelerimiz.' if not en else 'Featured projects.' }}</h2><p>{{ homepage.productsIntro[entry.lang] }}</p></div><a class="text-link" href="{{ links.products }}">{{ 'Tüm projeler' if not en else 'All projects' }} {{ arrow() }}</a></div>
  <div class="project-grid">{% for project in catalog.featured %}{% set projectPrefix = 'home-panel-' %}{% include 'modern/project-card.njk' %}{% endfor %}</div>
  <div class="project-directory"><h2>{{ 'Fikirden yayına.' if not en else 'From idea to launch.' }}</h2><p>{{ 'Yayındaki ürünlerimiz, geliştirdiğimiz projeler ve araştırmalarımız.' if not en else 'Our live products, work in development and research.' }}</p>{% include 'modern/project-groups.njk' %}</div>
</section>
<section class="home-method shell" id="our-approach" aria-labelledby="method-heading">
  <div class="home-method-intro"><h2 id="method-heading">{{ homepage.approachTitle[entry.lang] }}</h2><div><p>{{ homepage.approachIntro[entry.lang] }}</p><a class="text-link" href="{{ links.about }}">{{ c.storyLink }} {{ arrow(true) }}</a></div></div>
  <div class="home-method-steps">{% for step in homepage.process %}<div><h3>{{ step.title[entry.lang] }}</h3><p>{{ step.body[entry.lang] }}</p></div>{% endfor %}</div>
</section>
<section class="studio-news shell"><div class="studio-news-heading"><h2>{{ 'Son ürün güncellemesi.' if not en else 'Latest product update.' }}</h2><a class="text-link" href="{{ links.updates }}">{{ c.allUpdates }} {{ arrow() }}</a></div>{{ updateList(modern.updates,entry.lang,c,links) }}</section>
<section class="home-next shell"><div><h2>{{ homepage.closing[entry.lang] }}</h2><p>{{ homepage.closingText[entry.lang] }}</p></div><a class="button" href="{{ links.contact }}">{{ homepage.contact[entry.lang] }} {{ arrow(true) }}</a></section>
</div>
