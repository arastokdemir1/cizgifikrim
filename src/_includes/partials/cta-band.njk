{#- CTA BANDI (X07 İnce): vurgu (buz mavisi) adası. Parametreler (include'dan önce {% set %}; hepsi isteğe bağlı): ctaBaslik (HTML; varsayılan "Fikriniz <em>var mı?</em>"), ctaMetin, ctaHref (varsayılan nav.cta.href = /gorusme/), ctaEtiket.
    Sahip: Frontend-2 (içerik/yerleşim); düğme stili .pill--dark (Frontend-1, buttons.css). Aynı bileşen her sayfada. -#}
{%- set _cb = ctaBaslik or 'Fikriniz <em>var mı?</em>' -%}
{%- set _cm = ctaMetin or 'Ücretsiz keşif görüşmesinde ne istediğinizi dinler, nasıl yapılacağını söyleriz.' -%}
{%- set _ch = ctaHref or nav.cta.href -%}
{%- set _ce = ctaEtiket or nav.cta.etiket -%}
<section class="sec cta-band" aria-labelledby="cta-baslik">
  <div class="container">
    <div class="cta-band__metin">
      <h2 class="h2" id="cta-baslik">{{ _cb | safe }}</h2>
      <p class="lead">{{ _cm }}</p>
    </div>
    <a class="pill pill--dark" href="{{ _ch }}">{{ _ce }} <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></a>
  </div>
</section>
