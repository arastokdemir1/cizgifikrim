{#- Footer (X07 İnce; koyu, çerçevesiz): © + İstanbul, sayfa bağlantıları, e-posta, yasal. Proje adı yok. "Giriş" yalnız nav.giris varsa. -#}
<footer class="site-footer theme-dark">
  <div class="footer-in">
    <span class="footer-sol">© 2026 {{ site.name }} · İstanbul, Türkiye</span>
    <nav class="footer-links" aria-label="Alt menü">
      {%- for item in nav.ana %}<a href="{{ item.href }}">{{ item.etiket }}</a>{% endfor %}
      <a href="{{ nav.cta.href }}">Görüşme</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      {%- for l in nav.alt.yasal %}<a href="{{ l.href }}">{{ l.etiket }}</a>{% endfor %}
      {%- if nav.giris %}<a href="{{ nav.giris.href }}">{{ nav.giris.etiket }}</a>{% endif %}
    </nav>
  </div>
</footer>
