{#- HİZMET DETAYI şablonu (mobil uygulama, yapay zekâ ve otomasyon): Web sayfasıyla (hizmetler/web-sitesi-ve-e-ticaret.njk) aynı iskelet, icerik_ortak PART G2/G3.
    Sıra: Hero (+ içindekiler) · Kime uygun · Kapsam · Ne teslim ederiz · Örnek akış (VARSAYIMSAL) · Özel bölüm · Örnek iş · SSS · CTA bandı · diğer hizmetler.
    Veri: _data/hizmetDetay.js (h). Süre/fiyat/sıralama/doğruluk sözü yok; "Teklifte yazılmayan iş kapsam dışıdır…" cümlesi ONAYLI; projeye yalnız metin linki. -#}
{%- set ok -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>{%- endset -%}
{%- set tumHizmetler = [{ slug: 'web-sitesi-ve-e-ticaret', ad: 'Web sitesi ve e-ticaret' }, { slug: 'mobil-uygulama', ad: 'Mobil uygulama' }, { slug: 'yapay-zeka-ve-otomasyon', ad: 'Yapay zekâ ve otomasyon' }] -%}

{# ───────── HERO (koyu) ───────── #}
<section class="sec hz-hero theme-dark" aria-labelledby="hz-baslik">
  <div class="container hz-hero__grid">
    <div class="hz-hero__metin">
      <nav class="hz-kirinti" aria-label="Konum"><a href="/hizmetler/">Hizmetler</a><span aria-hidden="true">›</span><span aria-current="page">{{ h.kirinti }}</span></nav>
      <h1 class="h1 hz-hero__h1" id="hz-baslik">{{ h.ad }} <em>{{ h.vurgu }}</em></h1>
      <p class="lead hz-hero__lead">{{ h.lead }}</p>
      <p class="hz-hero__p">{{ h.ek }}</p>
      {%- if h.etiketler.length %}<ul class="tags{% if h.etiketTekrar %} hz-tags--tekrar{% endif %}">{% for e in h.etiketler %}<li class="tag">{{ e }}</li>{% endfor %}</ul>{% endif %}
      <div class="hz-hero__cta">
        <a class="pill pill--primary" href="{{ nav.cta.href }}">{{ nav.cta.etiket }} {{ ok | safe }}</a>
        <span class="hz-hero__not">Kısa sürede dönüş yapıyoruz.</span>
      </div>
      <nav class="hz-icindekiler" aria-label="Sayfa içeriği">
        <a href="#kime-uygun">Kime uygun</a><a href="#kapsam">Kapsam</a><a href="#teslimler">Teslimler</a><a href="#ornek-akis">Örnek akış</a><a href="#ozel">{{ h.ozel.etiket }}</a><a href="#sss">SSS</a>
      </nav>
    </div>
    <div class="hz-hero__sema">
      {% include "partials/schema/" + h.sema + ".njk" %}
      <ul class="hz-notlar" aria-label="Şemadaki notlar">{% for n in h.notlar %}<li>{{ n }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

{# ───────── KİME UYGUN (krem ada) ───────── #}
<section class="sec hz-bolum theme-light" id="kime-uygun" aria-labelledby="kime-baslik">
  <div class="container">
    <div class="sec-head">
      <span class="kicker">Kime uygun</span>
      <h2 class="h2" id="kime-baslik">Kime <em>uygun</em></h2>
      <p class="lead">{{ h.kime }}</p>
      <p class="hz-blok__alt">{{ h.kimeEk }}</p>
    </div>
    <ul class="hz-profiller" role="list">
      {%- for pr in h.profiller %}
      <li><span class="hz-profil__no" aria-hidden="true">0{{ loop.index }}</span><h3 class="h4">{{ pr[0] }}</h3><p>{{ pr[1] }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

{# ───────── KAPSAM (koyu) ───────── #}
<section class="sec hz-bolum theme-dark" id="kapsam" aria-labelledby="kapsam-baslik">
  <div class="container">
    <div class="sec-head">
      <span class="kicker">Kapsam</span>
      <h2 class="h2" id="kapsam-baslik">Kapsam nasıl <em>belirlenir?</em></h2>
      <p class="lead">{{ h.kapsamGiris }}</p>
    </div>
    <ol class="hz-liste" role="list">
      {%- for k in h.kapsam %}
      <li><span class="hz-liste__no" aria-hidden="true">0{{ loop.index }}</span><div><b>{{ k[0] }}</b><span>{{ k[1] }}</span></div></li>
      {%- endfor %}
    </ol>
    <p class="hz-not">{{ h.kapsamNot }}</p>
    <p class="hz-not">Süreyi görüşmede netleştiririz; fiyat kapsama göre, yazılı teklifle belirlenir.</p>
  </div>
</section>

{# ───────── NE TESLİM EDERİZ (krem ada) ───────── #}
<section class="sec hz-bolum theme-light" id="teslimler" aria-labelledby="teslim-baslik">
  <div class="container">
    <div class="sec-head">
      <span class="kicker">Teslimler</span>
      <h2 class="h2" id="teslim-baslik">Ne <em>teslim</em> ederiz</h2>
    </div>
    <ul class="hz-liste" role="list">
      {%- for t in h.teslim %}
      <li><span class="hz-liste__no" aria-hidden="true">0{{ loop.index }}</span><div><b>{{ t[0] }}</b><span>{{ t[1] }}</span></div></li>
      {%- endfor %}
    </ul>
    <p class="hz-not">{{ h.teslimNot }}</p>
  </div>
</section>

{# ───────── ÖRNEK AKIŞ (koyu; VARSAYIMSAL) ───────── #}
<section class="sec hz-bolum hz-akis theme-dark" id="ornek-akis" aria-labelledby="akis-baslik">
  <div class="container">
    <div class="sec-head">
      <span class="kicker">Örnek akış</span>
      <h2 class="h2" id="akis-baslik">{{ h.akisBaslik | safe }}</h2>
      <p class="lead">{{ h.akisGiris }}</p>
    </div>
    <ol class="hz-adimlar" role="list">
      {%- for a in h.akis %}
      <li class="hz-adim__oge">
        <span class="hz-adim__no" aria-hidden="true">0{{ loop.index }}</span>
        <h3 class="h4">{{ a[0] }}</h3>
        <p>{{ a[1] }}</p>
        {%- if a[2] | length %}<div class="hz-adim__meta">{% for m in a[2] %}<p><b>{{ m[0] }}:</b> {{ m[1] }}</p>{% endfor %}</div>{% endif %}
      </li>
      {%- endfor %}
    </ol>
    <p class="hz-not">{{ h.akisNot }}</p>
  </div>
</section>

{# ───────── ÖZEL BÖLÜM (krem ada): platform ve teknoloji / insan kontrolü ───────── #}
<section class="sec hz-bolum hz-eticaret theme-light" id="ozel" aria-labelledby="ozel-baslik">
  <div class="container">
    <div class="sec-head">
      <span class="kicker">{{ h.ozel.etiket }}</span>
      <h2 class="h2" id="ozel-baslik">{{ h.ozel.baslik | safe }}</h2>
      <p class="lead">{{ h.ozel.lead }}</p>
    </div>
    <div class="grid grid-3 hz-kartlar">
      {%- for k in h.ozel.kartlar %}
      <article class="hz-kart">
        <svg class="ikon" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">{{ k.ikon | safe }}</svg>
        <h3 class="h4">{{ k.ad }}</h3>
        <ul class="hz-madde" role="list">{% for m in k.maddeler %}<li>{{ m }}</li>{% endfor %}</ul>
      </article>
      {%- endfor %}
    </div>
    <p class="hz-not">{{ h.ozel.not }}</p>
    {%- if h.ozel.cipler.length %}<ul class="tags hz-cipler">{% for c in h.ozel.cipler %}<li class="tag">{{ c }}</li>{% endfor %}</ul>{% endif %}
  </div>
</section>

{# ───────── ÖRNEK İŞ (koyu; yalnız metin linki) ───────── #}
<section class="sec hz-bolum theme-dark" aria-label="Örnek iş">
  <div class="container hz-araclar">
    <div class="hz-ornek hz-araclar__blok">
      <p class="hz-ornek__satir">{{ h.ornek.onek }} {% for l in h.ornek.link %}<a class="link" href="{{ l.href }}">{{ l.ad }} {{ ok | safe }}</a> {% endfor %}</p>
      <p class="hz-ornek__cumle">{{ h.ornek.cumle }}</p>
    </div>
  </div>
</section>

{# ───────── SSS (krem ada; JSON-LD hizmetler/<slug>.11tydata.js'te) ───────── #}
<section class="sec theme-light" id="sss" aria-labelledby="sss-baslik">
  <div class="container faq-grid">
    <h2 class="h2" id="sss-baslik">Sık sorulan <em>sorular</em></h2>
    <div class="faq-list">
      {%- for q in h.sss %}
      <details class="faq-item"><summary>{{ q[0] }}<i aria-hidden="true"></i></summary><p class="faq-a">{{ q[1] }}</p></details>
      {%- endfor %}
    </div>
  </div>
</section>

{% include "partials/cta-band.njk" %}
<section class="sec sec--tight theme-dark hz-diger" aria-label="Diğer hizmetler">
  <div class="container"><p class="hz-diger__satir">Diğer hizmetler: {% for x in tumHizmetler %}{% if x.slug != h.slug %}<a class="link" href="/hizmetler/{{ x.slug }}/">{{ x.ad }} {{ ok | safe }}</a> {% endif %}{% endfor %}</p></div>
</section>
