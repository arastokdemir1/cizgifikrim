  ["Kapsam", "Sayfaların listesi, içeriğin kimden geleceği ve (e-ticaret varsa) ürün ve kategori yapısı yazıya geçer.", "Çıktı: yazılı kapsam ve teklif.", '<rect x="7" y="4" width="26" height="32" rx="6" class="l"/><path d="M13 13h14M13 20h14M13 27h8" class="l"/>'],
  ["Yapım", "Tasarım ve yapım ara çıktılarla ilerler; geri bildirimlerinizi geri bildirim turlarında alırız.", "Çıktı: gözden geçirebileceğiniz çalışan sürümler.", '<path d="M20 5l15 8-15 8L5 13z" class="l"/><path d="M5 20l15 8 15-8M5 27l15 8 15-8" class="l"/>'],
  ["Yayın", "Alan adı bağlanır, site yayına alınır, kullanım ve bakım notu teslim edilir; destek kapsamı teklifteki gibidir.", "", '<circle cx="20" cy="20" r="15" class="l"/><path d="M5 20h30M20 5c-8 8-8 22 0 30M20 5c8 8 8 22 0 30" class="l"/>']
] -%}
{%- set eticaret = [
  ["Ürün açıklaması", ["Ürün adı, özellik, malzeme ve kullanım bilgilerinizden yola çıkılır.", "Okunur, satışa uygun, abartısız dil.", "Kendi sitenizde ve pazar yerinde kullanılabilir biçim.", "Son metni siz onaylarsınız."], "ikon-ilke1"],
  ["Arama başlığı", ["Pazar yerinde aranan ifadelere göre başlık önerisi.", "Ürünün ne olduğunu ilk bakışta anlatan düzen.", "Ürün türüne göre tutarlı başlık yapısı."], "ara"],
  ["Arka plan ve ışık düzenleme", ["Ürüne dokunmadan: şekli, rengi, yazısı ve logosu aynı kalır; yalnız arka plan ve ışık değişir.", "Manken ya da ürünü değiştiren düzenleme yok.", "Yapay zekâ destekli araçlarla yapılır; nihai görseli siz onaylarsınız.", "Pazar yeri kuralları değişir; yüklemeden önce ilgili pazar yerinin kurallarını kontrol etmenizi öneririz."], "isik"]
] -%}
{%- set sss = [
  ["Nasıl başlarız?", "Ücretsiz keşif görüşmesi ayırın ya da formu doldurun. Kısa bir görüşmede ne istediğinizi dinler, nasıl yapılacağını söyleriz."],
  ["Ne kadar sürer?", "Kapsama bağlıdır; süreyi görüşmede netleştiririz."],
  ["Fiyat nasıl belirlenir?", "Kapsama göre, yazılı teklifle."],
  ["Siteyi sonradan kim güncelleyecek?", "Kapsama göre belirlenir: kimi sitelerde siz, kimi sitelerde biz güncelleriz. Hangisinin uygun olduğunu görüşmede konuşuruz."],
  ["Alan adı ve yayın işini siz mi yaparsınız?", "Alan adı bağlama ve yayına alma teslimata dahildir. Mevcut alan adınız varsa onu kullanırız."],
  ["Arama sonuçlarında üst sırada çıkacak mıyım?", "Sıralama garantisi vermeyiz. Başlık, açıklama ve site haritası gibi temel hazırlığı yaparız."],
  ["Yayından sonra destek var mı?", "Evet. Kapsamı teklifte ayrıca yazılır."],
  ["Ürünüm gerçekten böyle görünecek mi?", "Ürüne dokunmuyoruz; yalnız arka plan ve ışığı düzenliyoruz. Şekil, renk, yazı ve logo aynı kalır; onay sizde."]
] -%}

{# ───────── 1 · HERO (koyu) ───────── #}
<section class="sec hz-hero theme-dark" aria-labelledby="hz-baslik">
  <div class="hz-hero__fx" aria-hidden="true"><i></i></div>
  <div class="container hz-hero__grid">
    <div class="hz-hero__metin">
      <nav class="hz-kirinti" aria-label="Konum" data-in style="--i:0"><a href="/hizmetler/">Hizmetler</a><span aria-hidden="true">›</span><span aria-current="page">Web sitesi ve e-ticaret</span></nav>
      <h1 class="h1 hz-hero__h1" id="hz-baslik" data-in style="--i:1">Web sitesi ve <em>e-ticaret</em></h1>
      <p class="lead hz-hero__lead" data-in style="--i:2">İşinizi anlatan, hızlı açılan, telefonda düzgün çalışan bir web sitesi ya da satış akışı. Gösterişten önce okunurluk ve hız.</p>
      <p class="hz-hero__p" data-in style="--i:3">Her projeye aynı soruyla başlarız: bu site kimin için, ne yapmasını istiyoruz? Cevap netleşmeden tasarıma geçmeyiz.</p>
      <ul class="tags" data-in style="--i:4"><li class="tag">Tasarım</li><li class="tag">Yapım</li><li class="tag">Yayın</li></ul>
      <div class="hz-hero__cta" data-in style="--i:5">
        <a class="pill pill--primary" href="{{ nav.cta.href }}">{{ nav.cta.etiket }} {{ ok | safe }}</a>
        <span class="hz-hero__not">Kısa sürede dönüş yapıyoruz.</span>
      </div>
    </div>
    <div class="hz-hero__sema" data-reveal="fade">
      {% include "partials/schema/s2a-detay.njk" %}
      <ul class="hz-notlar" aria-label="Şemadaki notlar"><li>Alan adı</li><li>İletişim formu</li><li>Arama (SEO)</li><li>Mobil önce</li></ul>
    </div>
  </div>
</section>

{# ───────── 2 · KİME UYGUN + NE TESLİM EDERİZ (açık, sticky split) ───────── #}
<section class="sec hz-kunye theme-light" aria-labelledby="kunye-baslik">
  <div class="container split">
    <div class="hz-kunye__sol">
      <span class="kicker" data-reveal><b>01</b><span class="dash"></span>KAPSAM</span>
      <h2 class="h2" id="kunye-baslik" data-reveal style="--i:1">Kime uygun, <em>ne teslim</em> ederiz</h2>
    </div>
    <div class="hz-kunye__sag">
      <div class="hz-blok" data-reveal>
        <h3 class="kicker">Kime uygun</h3>
        <p class="hz-blok__metin">Hizmetini ya da ürününü internette göstermek ve satmak isteyen işletmeler ve girişimler.</p>
        <p class="hz-blok__alt">Sıfırdan bir site mi gerekiyor, yoksa var olan site telefonda zor mu kullanılıyor, güncel durmuyor mu? İkisinde de aynı yoldan gideriz: önce ihtiyacı yazar, sonra yaparız.</p>
        <ul class="hz-profiller" role="list">
          {%- for pr in profiller %}
          <li data-reveal style="--i:{{ loop.index0 }}"><span class="hz-profil__no" aria-hidden="true">0{{ loop.index }}</span><h4 class="h4">{{ pr[0] }}</h4><p>{{ pr[1] }}</p></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="hz-blok" data-reveal>
        <h3 class="kicker">Ne teslim ederiz</h3>
        <ul class="hz-liste" role="list">
          {%- for t in teslim %}
          <li data-reveal style="--i:{{ loop.index0 % 4 }}"><span class="hz-liste__no" aria-hidden="true">0{{ loop.index }}</span><div><b>{{ t[0] }}</b><span>{{ t[1] }}</span></div></li>
          {%- endfor %}
        </ul>
        <p class="hz-not">Kapsamın tamamı görüşmeden sonra yazılı teklifte netleşir; süreyi görüşmede netleştiririz.</p>
      </div>
    </div>
  </div>
</section>

{# ───────── 3 · NASIL ÇALIŞIRIZ (koyu, 4 adım) ───────── #}
<section class="sec hz-adim theme-dark" aria-labelledby="adim-baslik">
  <div class="container">
    <div class="sec-head">
      <span class="kicker" data-reveal><b>02</b><span class="dash"></span>SÜREÇ</span>
      <h2 class="h2" id="adim-baslik" data-reveal style="--i:1">Nasıl <em>çalışırız</em></h2>
    </div>
    <ol class="hz-adimlar" role="list">
      {%- for a in adimlar %}
      <li class="hz-adim__oge" data-reveal style="--i:{{ loop.index0 }}">
        <div class="hz-adim__ust"><span class="hz-adim__no" aria-hidden="true">0{{ loop.index }}</span><svg class="ikon" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">{{ a[3] | safe }}</svg></div>
        <h3 class="h4">{{ a[0] }}</h3>
        <p>{{ a[1] }}</p>
        {%- if a[2] %}<p class="hz-adim__meta">{{ a[2] }}</p>{% endif %}
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{# ───────── 4 · E-TİCARET İÇERİĞİ (açık) ───────── #}
<section class="sec hz-eticaret theme-light" aria-labelledby="eticaret-baslik">
  <div class="container">
    <div class="sec-head">
      <span class="kicker" data-reveal><b>03</b><span class="dash"></span>E-TİCARET İÇERİĞİ</span>
      <h2 class="h2" id="eticaret-baslik" data-reveal style="--i:1">E-ticaret <em>içeriği</em></h2>
      <p class="lead" data-reveal style="--i:2">Ürünleriniz için okunur, satışa uygun içerik.</p>
      <p class="hz-blok__alt" data-reveal style="--i:3">İçeriği ürününüzün bilgilerinden yola çıkarak hazırlarız; nihai metni ve görseli siz onaylarsınız.</p>
    </div>
    <div class="grid grid-3 hz-kartlar">
      {%- for e in eticaret %}
      <article class="hz-kart" data-reveal style="--i:{{ loop.index0 }}">
        {%- if e[2] == "ikon-ilke1" %}{% include "partials/schema/ikon-ilke1.njk" %}
        {%- elif e[2] == "ara" %}<svg class="ikon" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true"><circle cx="18" cy="18" r="10" class="l"/><path d="M26 26l9 9" class="l"/><path d="M13 18h10" class="l"/></svg>
        {%- else %}<svg class="ikon" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true"><rect x="5" y="8" width="30" height="24" rx="6" class="l"/><circle cx="26" cy="16" r="3" class="l"/><path d="M5 27l9-7 8 6 5-4 8 6" class="l"/></svg>{% endif %}
        <h3 class="h4">{{ e[0] }}</h3>
        <ul class="hz-madde" role="list">{% for m in e[1] %}<li>{{ m }}</li>{% endfor %}</ul>
      </article>
      {%- endfor %}
    </div>
    <p class="hz-not" data-reveal>Yapay zekâ destekli araçlarla yapılır; ürünün şekli, rengi ve detayı değişmez.</p>
    <div class="hz-ornek" data-reveal>
      <p class="hz-ornek__satir">Web sitesi örnekleri: <a class="link" href="/calismalar/vesira/">Vesira {{ ok | safe }}</a> <a class="link" href="https://polishreel.com" target="_blank" rel="noopener noreferrer">PolishReel {{ ok | safe }}</a></p>
      <p class="hz-ornek__cumle">İki ürünün web sitesini de baştan sona biz tasarlayıp geliştirdik.</p>
    </div>
  </div>
</section>

{# ───────── 5 · SSS (açık, 8 soru) ───────── #}
<section class="sec theme-light" id="sss" aria-labelledby="sss-baslik">
  <div class="container faq-grid">
    <h2 class="h2" id="sss-baslik" data-reveal>Sık sorulan <em>sorular</em></h2>
    <div class="faq-list">
      {%- for q in sss %}
      <details class="faq-item" data-reveal style="--i:{{ loop.index0 % 4 }}"><summary>{{ q[0] }}<i aria-hidden="true"></i></summary><p class="faq-a">{{ q[1] }}</p></details>
      {%- endfor %}
    </div>
  </div>
</section>

{% include "partials/cta-band.njk" %}
