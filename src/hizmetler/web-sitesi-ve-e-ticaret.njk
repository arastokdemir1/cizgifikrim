  ["Mevcut sitesini yenilemek isteyen işletme", "Telefonda düzgün çalışan, okunur ve güncellenebilir bir yapı."],
  ["Ürünlerini internette satmak isteyen girişim", "Ürün sayfaları ve satış akışı; kapsam görüşmede yazılı olarak belirlenir."]
] -%}
{%- set teslim = [
  ["Tasarım ve yapım", "Sayfa yapısı, görsel dil ve içerik yerleşimi birlikte tasarlanır ve çalışan siteye dönüştürülür."],
  ["Telefonda hızlı açılma ve erişilebilirlik", "Önce telefon: okunur yazı boyutu, rahat dokunma alanları, gereksiz yük yok."],
  ["Alan adı ve yayın kurulumu", "Alan adı bağlanır, site güvenli bağlantıyla (HTTPS) yayına alınır; mevcut alan adınız varsa onu kullanırız."],
  ["Temel arama (SEO) hazırlığı", "Sayfa başlıkları, açıklamalar ve site haritası düzenlenir. Arama sonuçlarında sıralama garantisi verilmez."],
  ["İletişim yapısı", "İhtiyaca göre iletişim formu, e-posta bağlantısı ya da takvim (görüşme ayırma) bağlantısı."],
  ["İçerik yerleşimi", "Metin ve görseller teslim edilen yapıya yerleştirilir; içeriği sizden alırız ya da birlikte hazırlarız."],
  ["Kullanım ve bakım notu", "Sitenin nasıl güncelleneceğini ve nasıl çalıştığını anlatan kısa not."],
  ["Yayın sonrası destek", "Bakım ve geliştirme kapsamı teklifte ayrıca yazılır."]
] -%}
{%- set adimlar = [
