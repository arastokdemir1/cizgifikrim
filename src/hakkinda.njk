permalink: /hakkinda/
sayfaCss: ['components/schema', 'components/services', 'components/sections', 'pages/hakkinda']
bodyClass: pg-hakkinda
jsonld:
  - "@type": BreadcrumbList
    itemListElement:
      - { "@type": ListItem, position: 1, name: "Hakkında", item: "https://cizgifikrim.net/hakkinda/" }
  - "@type": AboutPage
    name: "Hakkında"
    url: "https://cizgifikrim.net/hakkinda/"
